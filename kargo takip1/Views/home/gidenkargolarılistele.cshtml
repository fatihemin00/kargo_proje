@using kargo_takip1.Models
@model List<GidenKargoTakip>

@{
    ViewBag.Title = "Giden Kargo Listesi";
}

<h2 style="text-align:center">Giden Ürünler Sayfası</h2>
@if (User.IsInRole("A") || User.IsInRole("B"))
{
    <a href="/home/gidenKargoEkle" class="btn btn-primary">Giden Kargo Ekle</a>
}

<br />

<table class="table table-bordered" id="myTable">
    <thead>
        <tr>
            <th>İrsaliye Numarası</th>
            <th>Kargo Adı</th>
            <th>Giden Firma Adı</th>
            <th>Ürün Adı</th>
            <th>Ürün Seri Numarası</th>
            <th>Gönderilme Tarihi</th>
            <th>Gönderen Kişi</th>
            <th>Açıklama</th>
            <th>SİL</th>
            <th>DÜZENLE</th>
        </tr>
    </thead>
    <tbody>
        @{
            var groupedItems = Model.GroupBy(x => x.irsaliyeNo);
            foreach (var group in groupedItems)
            {
                var firstItem = group.FirstOrDefault();
                <tr>
                    <td rowspan="@group.Count()">@firstItem.irsaliyeNo</td>
                    <td rowspan="@group.Count()">@firstItem.KargoFirmaları.KargoAdi</td>
                    <td rowspan="@group.Count()">@firstItem.Sirketler.sirketAdi</td>
                    <td>@firstItem.gidenUrunlerBilgi.GidenurunAdi</td>
                    <td>@firstItem.gidenUrunlerBilgi.GidenurunSeriNo</td>
                    <td>@firstItem.gonderilenTarih</td>
                    <td>@firstItem.Kullanıcılar.kullaniciAdiSoyadi</td>
                    <td>@firstItem.acıklama</td>

                    
                    @if (firstItem.Kullanıcılar.Id == ViewBag.CurrentUserId)
                    {
                    <td>@Html.ActionLink("Sil", "sil", new { id = firstItem.Id }, new { @class = "btn btn-danger", onclick = "return confirm('Silmek istiyor musunuz?')" })</td>
                    <td><a href="/home/guncelle1/@firstItem.Id" class="btn btn-danger">Düzenle</a></td>
                    }
                    else
                    {
                    <td></td> <!-- Boş bırak -->
                    <td></td> <!-- Boş bırak -->
                    }

                    <td><a href="/home/KargoKapağılistele/@firstItem.Id" class="btn btn-success">Kargo Kapağı</a></td>
                </tr>

                foreach (var item in group.Skip(1))
                {
                    <tr>
                        <td>@item.gidenUrunlerBilgi.GidenurunAdi</td>
                        <td>@item.gidenUrunlerBilgi.GidenurunSeriNo</td>
                        <td>@item.gonderilenTarih</td>
                        <td>@item.Kullanıcılar.kullaniciAdiSoyadi</td>
                        <td>@item.acıklama</td>

                        
                       @if (firstItem.Kullanıcılar.Id == ViewBag.CurrentUserId)
                       {
                        <td>@Html.ActionLink("Sil", "sil", new { id = item.Id }, new { @class = "btn btn-danger", onclick = "return confirm('Silmek istiyor musunuz?')" })</td>
                        <td><a href="/home/guncelle1/@item.Id" class="btn btn-danger">Düzenle</a></td>
                        }
                        else
                        {
                        <td></td> <!-- Boş bırak -->
                        <td></td> <!-- Boş bırak -->
                        }

                        <td><a href="/home/KargoKapağılistele/@firstItem.Id" class="btn btn-success">Kargo Kapağı</a></td>
                    </tr>
                }
            }
        }
    </tbody>

</table>


<script>
    // Arama işlevselliği
    document.getElementById('searchInput').addEventListener('keyup', function () {
        var input = this.value.toLowerCase();
        var rows = document.querySelectorAll('#myTable tbody tr');

        rows.forEach(function (row) {
            var cells = row.querySelectorAll('td');
            var match = false;
            cells.forEach(function (cell) {
                if (cell.textContent.toLowerCase().includes(input)) {
                    match = true;
                }
            });
            row.style.display = match ? '' : 'none';
        });
    });
    // Satır silme işlevselliği
    function deleteRow(button) {
        var row = button.parentNode.parentNode;
        row.parentNode.removeChild(row);
    }

    // Satır düzenleme işlevselliği (bu işlevsel olarak bir sayfaya yönlendirme yapar)
    function editRow(button) {
        var row = button.parentNode.parentNode;
        var id = row.cells[0].textContent;
        window.location.href = '/home/guncelle/' + id;
    }
</script>
