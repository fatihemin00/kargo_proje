@using kargo_takip1.Models
@model List<GelenKargoTakip>
@{
    ViewBag.Title = "gelenkargolarılistele";
}
<style>
    table {
        width: 100%;
        border-collapse: collapse;
    }

    table, th, td {
        border: 1px solid black;
    }

    th, td {
        padding: 8px;
        text-align: left;
    }

    th {
        background-color: #f2f2f2;
    }

    .search-box {
        margin-bottom: 10px;
        float: right;
    }
</style>

<h2 style="text-align:center">Gelen Ürünler Sayfası</h2>
<input type="text" id="searchInput" class="search-box" placeholder="Ara...">
@if (User.IsInRole("A"))
{
    <a href="/home/gelenKargoEkle" class="btn btn-primary">Gelen Kargo ekle</a>
}

<br />
<br />
<table class="table table-bordered" id="myTable">
    <thead>
        <tr>
            <th><strong>İrsaliye Numarası</strong></th>
            <th><strong>Kargo Adı</strong></th>
            <th><strong>Ürün Adı</strong></th>
            <th><strong>Teslim Alan İsmi</strong></th>
            <th><strong>Geldiği Tarih</strong></th>
            <th><strong>Durumu</strong></th>
            <th><strong>Kontrol Eden Kişi</strong></th>
            <th><strong>Gönderen Şirket İsmi</strong></th>
            <th>SİL</th>
            <th>DÜZENLE</th>
        </tr>
    </thead>
    <tbody>
        @{
            var groupedItems = Model.GroupBy(x => x.irsaliyeNo);
            foreach (var group in groupedItems)
            {
                var firstItem = group.FirstOrDefault();
                <tr>
                    <td rowspan="@group.Count()">@firstItem.irsaliyeNo</td>
                    <td rowspan="@group.Count()">@firstItem.KargoFirmaları.KargoAdi</td>
                    <td>@firstItem.Urunler.urunAdi</td>
                    <td>@firstItem.Kullanıcılar.kullaniciAdiSoyadi</td>
                    <td>@firstItem.gelenTarih</td>
                    <td>@firstItem.durum</td>
                    <td>@firstItem.Kullanıcılar1.kullaniciAdiSoyadi</td>
                    <td>@firstItem.Sirketler.sirketAdi</td>
                    @if (firstItem.Kullanıcılar.Id == ViewBag.CurrentUserId)
                    {
                    <td>@Html.ActionLink("Sil", "sil1", new { id = firstItem.Id }, new { @class = "btn btn-danger", onclick = "return confirm('Silmek istiyor musunuz?')" })</td>
                    <td><a href="/home/guncelle/@firstItem.Id" class="btn btn-danger">Düzenle</a></td>
                    }
                    else
                    {
                    <td></td> <!-- Boş bırak -->
                    <td></td> <!-- Boş bırak -->
                    }
                </tr>
                foreach (var item in group.Skip(1))
                {
                    <tr>
                        <td>@item.Urunler.urunAdi</td>
                        <td>@item.Kullanıcılar.kullaniciAdiSoyadi</td>
                        <td>@item.gelenTarih</td>
                        <td>@item.durum</td>
                        <td>@item.Kullanıcılar1.kullaniciAdiSoyadi</td>
                        <td>@item.Sirketler.sirketAdi</td>
                        @if (firstItem.Kullanıcılar.Id == ViewBag.CurrentUserId)
                        {
                        <td>@Html.ActionLink("Sil", "sil1", new { id = item.Id }, new { @class = "btn btn-danger", onclick = "return confirm('Silmek istiyor musunuz?')" })</td>
                        <td><a href="/home/guncelle/@item.Id" class="btn btn-danger">Düzenle</a></td>
                        }
                        else
                        {
                        <td></td> <!-- Boş bırak -->
                        <td></td> <!-- Boş bırak -->
                        }
                    </tr>
                }
            }
        }
    </tbody>

</table>

<script>
    // Arama işlevselliği
    document.getElementById('searchInput').addEventListener('keyup', function () {
        var input = this.value.toLowerCase();
        var rows = document.querySelectorAll('#myTable tbody tr');

        rows.forEach(function (row) {
            var cells = row.querySelectorAll('td');
            var match = false;
            cells.forEach(function (cell) {
                if (cell.textContent.toLowerCase().includes(input)) {
                    match = true;
                }
            });
            row.style.display = match ? '' : 'none';
        });
    });

    // Satır silme işlevselliği
    function deleteRow(button) {
        var row = button.parentNode.parentNode;
        row.parentNode.removeChild(row);
    }

    // Satır düzenleme işlevselliği (bu işlevsel olarak bir sayfaya yönlendirme yapar)
    function editRow(button) {
        var row = button.parentNode.parentNode;
        var id = row.cells[0].textContent;
        window.location.href = '/home/guncelle/' + id;
    }
</script>
