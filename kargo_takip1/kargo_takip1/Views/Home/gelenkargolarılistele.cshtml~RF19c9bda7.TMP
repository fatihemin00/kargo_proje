@using kargo_takip1.Models
@model List<GelenKargoTakip>
@{
    ViewBag.Title = "gelenkargolarılistele";
}
<style>
    table {
        width: 100%;
        border-collapse: collapse;
    }

    table, th, td {
        border: 1px solid black;
    }

    th, td {
        padding: 8px;
        text-align: left;
    }

    th {
        background-color: #f2f2f2;
    }

    .search-box {
        margin-bottom: 10px;
        float: right;
    }
</style>

<h2 style="text-align:center">Gelen Ürünler Sayfası</h2>
<input type="text" id="searchInput" class="search-box" placeholder="Ara...">

    <a href="/home/gelenKargoEkle" class="btn btn-primary">Gelen Kargo ekle</a>
    <br />
    <br />
    <table class="table table-bordered" id="myTable">
        <thead>
            <tr>
                <th><strong>ID</strong>  </th>
                <th> <strong>Kargo Adı</strong></th>
                <th><strong>Ürün Adı</strong>  </th>
                <th> <strong> Teslim Alan İsmi</strong> </th>
                <th>  <strong> Geldiği Tarih </strong> </th>
                <th> <strong>İrsaliye Numarası</strong> </th>
                <th> <strong> Durumu</strong></th>
                <th> <strong> Kontrol Eden Kişi</strong></th>
                <th> <strong> Gönderen Şirket İsmi</strong></th>
                <th> SİL</th>
                <th> DÜZENLE</th>


            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.kargolar.KargoAdi</td>
                    <td>@item.urunler.urunAdi</td>
                    <td>@item.kullanici.kullaniciAdiSoyadi</td>
                    <td>@item.gelenTarih</td>
                    <td>@item.irsaliyeNo</td>
                    <td>@item.durum</td>
                    <td>@item.kullanici1.kullaniciAdiSoyadi</td>
                    <td>@item.sirketler.sirketAdi</td>
                    <td>@Html.ActionLink("sil", "sil1", new { id = item.gelenKargoID }, new { @class = "btn btn-danger", onclick = " return confirm ('silmek istiyormusun') " })</td>
                    <td><a href="/home/guncelle/@item.gelenKargoID " class="btn btn-danger"> Düzenle</a></td>
                </tr>
            }
        </tbody>
    </table>
    <script>
        // Arama işlevselliği
        document.getElementById('searchInput').addEventListener('keyup', function () {
            var input = this.value.toLowerCase();
            var rows = document.querySelectorAll('#myTable tbody tr');

            rows.forEach(function (row) {
                var cells = row.querySelectorAll('td');
                var match = false;
                cells.forEach(function (cell) {
                    if (cell.textContent.toLowerCase().includes(input)) {
                        match = true;
                    }
                });
                row.style.display = match ? '' : 'none';
            });
        });

        // Satır silme işlevselliği
        function deleteRow(button) {
            var row = button.parentNode.parentNode;
            row.parentNode.removeChild(row);
        }

        // Satır düzenleme işlevselliği (bu işlevsel olarak bir sayfaya yönlendirme yapar)
        function editRow(button) {
            var row = button.parentNode.parentNode;
            var id = row.cells[0].textContent;
            window.location.href = '/home/guncelle/' + id;
        }
    </script>
