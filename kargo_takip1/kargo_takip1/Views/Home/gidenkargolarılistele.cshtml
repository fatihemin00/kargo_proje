@model List<kargo_takip1.Models.GidenKargoTakip>
<!DOCTYPE html>
<html>
<head>
    <title>Giden Kargolar Sayfası</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }

        table, th, td {
            border: 1px solid black;
        }

        th, td {
            padding: 8px;
            text-align: left;
            font-size: 14px;
        }

        th {
            background-color: #f2f2f2;
        }

        .search-box {
            margin-bottom: 10px;
            width: 200px;
            padding: 5px;
        }

        .button-container {
            text-align: center;
            margin-bottom: 20px;
        }

        .table-container {
            max-width: 80%;
            margin: 0 auto;
            overflow-x: auto;
        }

        .btn {
            margin: 5px;
        }
    </style>
</head>
<body>
    @{
        ViewBag.Title = "gidenkargolarılistele";
    }
    <h2 style="text-align:center">Giden Kargolar Sayfası</h2>

    <div class="button-container">
        <input type="text" id="searchInput" class="search-box" placeholder="Ara...">

        <!-- SADECE PATRON (A) VE USTA (B) EKLE BUTONUNU GÖRÜR -->
        @if (ViewBag.Rol == "A" || ViewBag.Rol == "B")
        {
            <a href="/home/gidenKargoEkle" class="btn btn-primary">Giden Kargo Ekle</a>
        }
    </div>

    <div class="table-container">
        <table class="table table-bordered" id="myTable">
            <thead>
                <tr>
                    <th><strong>İrsaliye No</strong></th>
                    <th><strong>Giden Tarih</strong></th>
                    <th><strong>Açıklama</strong></th>

                    <!-- SADECE PATRON (A) VE USTA (B) İŞLEM BUTONLARINI GÖRÜR -->
                    @if (ViewBag.Rol == "A" || ViewBag.Rol == "B")
                    {
                        <th><strong>DÜZENLE</strong></th>
                        <th><strong>SİL</strong></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.irsaliyeNo</td>
                        <td>@(item.gonderilenTarih.HasValue ? item.gonderilenTarih.Value.ToString("dd.MM.yyyy") : "")</td>
                        <td>@item.acıklama</td>

                        @if (ViewBag.Rol == "A" || ViewBag.Rol == "B")
                        {
                            <td><a href="/home/guncelle1/@item.Id" class="btn btn-warning">Düzenle</a></td>
                            <td><a href="/home/sil/@item.Id" class="btn btn-danger" onclick="return confirm('Silmek istiyor musunuz?');">Sil</a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script>
        document.getElementById('searchInput').addEventListener('keyup', function () {
            var input = this.value.toLowerCase();
            var rows = document.querySelectorAll('#myTable tbody tr');

            rows.forEach(function (row) {
                var cells = row.querySelectorAll('td');
                var match = false;
                cells.forEach(function (cell) {
                    if (cell.textContent.toLowerCase().includes(input)) {
                        match = true;
                    }
                });
                row.style.display = match ? '' : 'none';
            });
        });
    </script>
</body>
</html>