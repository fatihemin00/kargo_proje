@model kargo_takip1.Models.Kullanıcılar
@{
    ViewBag.Title = "Kullanıcı Ekle";
}

<h2 style="text-align:center">Kullanıcı Ekleme Sayfası</h2>
<br />
<div class="container">
    <div class="row">
        <div class="col-md-6">
            <form id="kullanıcıekleform">

                <!-- GÜVENLİK: YENİ EKLENEN KULLANICI OTOMATİK "D" ROLÜYLE GİDECEK -->
                <input type="hidden" name="Rol" value="D" />

                <div class="form-group">
                    <label>Kullanıcı Adı Soyad Giriniz</label>
                    <input type="text" name="kullaniciAdiSoyadi" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Kullanıcı Mail Adresi Giriniz</label>
                    <input type="text" name="kullaniciMailAdresi" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Kullanıcı Şifresini Giriniz</label>
                    <input type="text" name="Sifre" class="form-control" required />
                </div>

                <button class="btn btn-primary" type="submit">Kaydet</button>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('kullanıcıekleform');

        // Formun `Enter` tuşu ile gönderilmesini engelle
        form.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                var focusableElements = form.querySelectorAll('input, select, textarea');
                var index = Array.prototype.indexOf.call(focusableElements, document.activeElement);
                if (index > -1 && index < focusableElements.length - 1) {
                    focusableElements[index + 1].focus();
                } else {
                    focusableElements[0].focus();
                }
            }
        });

        // AJAX ile form verilerini gönderme
        $("#kullanıcıekleform").submit(function (e) {
            e.preventDefault();

            var form = $(this);
            var actionUrl = '/Kullanici/Ekle';

            $.ajax({
                type: "POST",
                url: actionUrl,
                data: form.serialize(),
                success: function (data) {
                    window.location.href = '/Kullanici/Listele';
                },
                error: function () {
                    alert("Bir hata oluştu. Lütfen tekrar deneyin.");
                }
            });
        });
    });
</script>