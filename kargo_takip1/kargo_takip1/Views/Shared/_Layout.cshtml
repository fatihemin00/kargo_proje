@{
    Layout = null;

    // Giriş yapan kullanıcının adını ve rolünü anlık olarak çekiyoruz
    string userName = "Misafir";
    string userRole = "D";

    if (User.Identity.IsAuthenticated)
    {
        try
        {
            using (var db = new kargo_takip1.Models.adminEntities())
            {
                var email = User.Identity.Name;
                var user = db.Kullanıcılar.FirstOrDefault(x => x.kullaniciMailAdresi == email);
                if (user != null)
                {
                    userName = user.kullaniciAdiSoyadi;
                    userRole = user.Rol;
                }
            }
        }
        catch { }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Gora Kargo Takip</title>
    <link href="~/Content/all.min.css" rel="stylesheet" />
    <link href="~/Content/ionicons.min.css" rel="stylesheet" />
    <link href="~/Content/adminlte.min.css" rel="stylesheet" />
    <link href="~/Content/css1.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.3/css/jquery.dataTables.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.3/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">

        <!-- Navbar (Üst Bar) -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/home/Index" class="nav-link">Ana Sayfa</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a href="/Account/Login" class="nav-link text-danger font-weight-bold">
                        <i class="fas fa-sign-out-alt"></i> Çıkış Yap
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Sidebar (Sol Menü) -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Logo Alanı -->
            <a href="/home/Index" class="brand-link text-center">
                <span class="brand-text font-weight-bold">GORA KARIŞIK</span>
            </a>

            <div class="sidebar">
                <!-- Kullanıcı Profil Kartı (İsim ve Rol Gösterimi) -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex align-items-center">
                    <div class="image">
                        <i class="fas fa-user-circle fa-2x text-light ml-2"></i>
                    </div>
                    <div class="info ml-2">
                        <a href="#" class="d-block font-weight-bold text-light">@userName</a>
                        <span class="badge badge-info">Rol: @userRole</span>
                    </div>
                </div>

                <!-- Menü Linkleri -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        <!-- Gelen Kargo Menüsü -->
                        <li class="nav-item has-treeview">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-arrow-alt-circle-down"></i>
                                <p>Gelen Kargo <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/home/gelenkargolarılistele" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Gelen Kargo Listele</p>
                                    </a>
                                </li>
                                @if (userRole == "A" || userRole == "B")
                                {
                                    <li class="nav-item">
                                        <a href="/home/gelenKargoEkle" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Gelen Kargo Ekle</p>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <!-- Giden Kargo Menüsü -->
                        <li class="nav-item has-treeview">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-arrow-alt-circle-up"></i>
                                <p>Giden Kargo <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/home/gidenkargolarılistele" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Giden Kargo Listele</p>
                                    </a>
                                </li>
                                @if (userRole == "A" || userRole == "B")
                                {
                                    <li class="nav-item">
                                        <a href="/home/gidenKargoEkle" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Giden Kargo Ekle</p>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <!-- Envanter / Tanımlamalar Menüsü (Sadece A ve B görebilir) -->
                        @if (userRole == "A" || userRole == "B")
                        {
                            <li class="nav-item has-treeview">
                                <a href="#" class="nav-link">
                                    <i class="nav-icon fas fa-boxes"></i>
                                    <p>Envanter / Tanım <i class="fas fa-angle-left right"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="/Sirket/Listele" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Cari Kart / Şirketler</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="/KargoFirma/Listele" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Kargo Firmaları</p>
                                        </a>
                                    </li>
                                    @if (userRole == "A")
                                    {
                                        <li class="nav-item">
                                            <a href="/Kullanici/Listele" class="nav-link">
                                                <i class="far fa-circle nav-icon"></i>
                                                <p>Kullanıcılar</p>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                        <!-- Ürünler Menüsü -->
                        <li class="nav-item has-treeview">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-box-open"></i>
                                <p>Ürünler <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/Urun/GelenListele" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Gelen Ürünler</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Urun/GidenListele" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Giden Ürünler</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Ana İçerik Alanı -->
        <div class="content-wrapper">
            <div class="content pt-3">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/scripts/bootstrap.bundle.min.js"></script>
    <script src="~/scripts/adminlte.js"></script>
</body>
</html>