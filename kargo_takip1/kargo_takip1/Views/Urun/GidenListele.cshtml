@using kargo_takip1.Models
@model List<kargo_takip1.Models.gidenUrunlerBilgi>
<!DOCTYPE html>
<html>
<head>
    <title>Giden Ürünler Sayfası</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }

        table, th, td {
            border: 1px solid black;
        }

        th, td {
            padding: 8px;
            text-align: left;
            font-size: 14px;
        }

        th {
            background-color: #f2f2f2;
        }

        .search-box {
            margin-bottom: 10px;
            width: 200px;
            padding: 5px;
        }

        .button-container {
            text-align: center;
            margin-bottom: 20px;
        }

        .table-container {
            max-width: 80%;
            margin: 0 auto;
            overflow-x: auto;
        }

        .btn {
            margin: 5px;
        }
    </style>
</head>
<body>
    <h2 style="text-align:center">Giden Ürünler Bilgi Sayfası</h2>

    <div class="button-container">
        <input type="text" id="searchInput" class="search-box" placeholder="Ara...">

        <!-- A, B ve C ROLÜ GÖREBİLİR -->
        @if (ViewBag.Rol == "A" || ViewBag.Rol == "B" || ViewBag.Rol == "C")
        {
            <a href="/Urun/GidenEkle" class="btn btn-primary">Giden Ürün Ekle</a>
        }
    </div>

    <div class="table-container">
        <table class="table table-bordered" id="myTable">
            <thead>
                <tr>
                    <th><strong>Ürün Adı</strong></th>
                    <th><strong>Seri Numarası</strong></th>
                    <th><strong>Firma ID / Bilgi</strong></th>

                    <!-- A, B ve C ROLÜ GÖREBİLİR -->
                    @if (ViewBag.Rol == "A" || ViewBag.Rol == "B" || ViewBag.Rol == "C")
                    {
                        <th><strong>DÜZENLE</strong></th>
                        <th><strong>SİL</strong></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.GidenurunAdi</td>
                        <td>@item.GidenurunSeriNo</td>
                        <td>@item.gidenFirma</td>

                        <!-- A, B ve C ROLÜ GÖREBİLİR -->
                        @if (ViewBag.Rol == "A" || ViewBag.Rol == "B" || ViewBag.Rol == "C")
                        {
                            <td><a href="/Urun/GidenGuncelle/@item.Id" class="btn btn-warning">Düzenle</a></td>
                            <td><a href="/Urun/GidenSil/@item.Id" class="btn btn-danger" onclick="return confirm('Silmek istiyor musunuz?');">Sil</a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script>
        document.getElementById('searchInput').addEventListener('keyup', function () {
            var input = this.value.toLowerCase();
            var rows = document.querySelectorAll('#myTable tbody tr');
            rows.forEach(function (row) {
                var cells = row.querySelectorAll('td');
                var match = false;
                cells.forEach(function (cell) {
                    if (cell.textContent.toLowerCase().includes(input)) match = true;
                });
                row.style.display = match ? '' : 'none';
            });
        });
    </script>
</body>
</html>